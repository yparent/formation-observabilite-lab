            ],
            "mode": "seriesToRows"
          }
        }
      ]
    },
    {
      "id": 35,
      "type": "stat",
      "title": "Version déployée",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
