# CORRIGÉ TP 2 — instrumentation de shop-api (apps/shop-api/app.py)

# 1) Déclaration de la métrique (après APP_INFO) :
PRODUCT_VIEWS = Counter(
    "shop_product_views_total",
    "Consultations de fiche produit",
    ["product"],
)

# 2) Incrément dans la route /api/products/<product>, juste avant redis_incr :
    PRODUCT_VIEWS.labels(product=product).inc()

# 3) Reconstruire et redémarrer les deux instances :
#    docker compose up -d --build shop-api-1 shop-api-2
# 4) Vérifier :
#    curl -s localhost:5001/metrics | grep shop_product_views
